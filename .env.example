# Salin ke .env lalu isi. JANGAN commit .env.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/hermes_office_dev

# Kunci enkripsi kredensial runtime — openssl rand -base64 32
ENCRYPTION_KEY=
# Kunci penyegel cookie sesi — openssl rand -base64 32
NUXT_SESSION_PASSWORD=

NUXT_PUBLIC_APP_URL=http://localhost:3000
# demo = fixture berlabel DEMO tanpa aksi kontrol; live = API control plane
NUXT_PUBLIC_OFFICE_MODE=live

# Seed platform admin pertama (hapus setelah dipakai)
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
